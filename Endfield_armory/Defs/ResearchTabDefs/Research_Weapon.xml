<?xml version="1.0" encoding="utf-8"?>
<Defs>
    
    <!-- Вивчення зброї -->
    <ResearchProjectDef>
        <defName>EV_EndfieldMobilization</defName>
        <label>Endfield mobilization</label>

        <prerequisites>
            <li>EF_EndfieldTechnology</li>
            <li>EM_MaterialsProcessing</li>
        </prerequisites>

        <!-- Прив'язка до нової вкладки -->
        <tab>EF_ResearchTab_Endfield</tab>

        <!-- Координати сітки (X - колонка, Y - рядок) -->
