        <researchViewY>3.5</researchViewY>

        <baseCost>800</baseCost>
        <techLevel>Industrial</techLevel>
    </ResearchProjectDef>

    <ResearchProjectDef>
        <defName>EM_metalForming</defName>
        <label>Metal forming</label>

        <prerequisites>
            <li>EM_AdvancedMaterials</li>
            <li>EF_ImprovedFactories</li>
        </prerequisites>

        <!-- Прив'язка до нової вкладки -->
        <tab>EF_ResearchTab_Endfield</tab>

        <!-- Координати сітки (X - колонка, Y - рядок) -->
