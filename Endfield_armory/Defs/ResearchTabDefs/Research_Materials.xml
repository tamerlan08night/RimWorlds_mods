<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ResearchProjectDef>
        <defName>EM_MaterialsProcessing</defName>
        <label>Materials processing</label>

        <prerequisites>
            <li>EF_EndfieldTechnology</li>
        </prerequisites>

        <!-- Прив'язка до нової вкладки -->
        <tab>EF_ResearchTab_Endfield</tab>

        <!-- Координати сітки (X - колонка, Y - рядок) -->
        <researchViewX>1</researchViewX>
        <researchViewY>3</researchViewY>

        <baseCost>800</baseCost>
        <techLevel>Industrial</techLevel>
    </ResearchProjectDef>

    <ResearchProjectDef>
