<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <ThingDef ParentName="BuildingBase">
        <defName>IC_AIC_ShreddingUnit</defName>
        <label>AIC Shredding Unit</label>
        <description>A heavy facility that shreds and pulverizes various materials. Can you hear the crunch of the heavy industrial shredders?</description>

        <!-- C# Клас і Тікер -->
        <thingClass>AKE.endfield.Building_ICFactoryBase</thingClass>
        <tickerType>Normal</tickerType>

        <!-- Графіка та розміри -->
        <graphicData>
            <texPath>Things/Building/Production/IC_ShreddingUnit</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(3,3)</drawSize>
        </graphicData>
        <size>(3,3)</size>
        <passability>Impassable</passability>
        <fillPercent>1.0</fillPercent>

        <!-- Можливість переносити та будувати -->
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsProduction</li>
        </thingCategories>
        <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
        <designationCategory>Production</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>

        <!-- Характеристики -->
        <statBases>
            <MaxHitPoints>500</MaxHitPoints>
            <WorkToBuild>30000</WorkToBuild>
            <Mass>135</Mass>
            <Flammability>0.2</Flammability>
        </statBases>

        <!-- Вартість побудови -->
        <costList>
            <IC_Protocolpackage>1</IC_Protocolpackage>
            <IC_Automationpackage>1</IC_Automationpackage>
            <IC_Mechanicalpackage>1</IC_Mechanicalpackage>
            <Steel>100</Steel>
        </costList>

        <researchPrerequisites>
            <li>EF_EndfieldTechnology</li>
        </researchPrerequisites>

        <!-- Компоненти (Енергія) -->
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>500</basePowerConsumption>
            </li>
        </comps>

        <!-- Інтерфейс вкладки рецептів -->
        <inspectorTabs>
            <li>ITab_Bills</li>
        </inspectorTabs>

        <!-- Порожній список рецептів для підтримки патчів -->
        <recipes />

        <!-- Налаштування будівлі -->
        <building>
            <isSittable>false</isSittable>
            <workTableRoomRole>Workshop</workTableRoomRole>
            <buildingTags>
                <li>Production</li>
            </buildingTags>
        </building>
    </ThingDef>
</Defs>