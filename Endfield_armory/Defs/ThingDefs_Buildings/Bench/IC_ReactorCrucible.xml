<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <ThingDef ParentName="BuildingBase">
        <defName>IC_AIC_ReactorCrucible</defName>
        <label>AIC Reactor Crucible</label>
        <description>A facility for running solid or liquid-state chemical reactions.
            After multiple incidents of reactor failures caused by material fatigue and corrosion, Endfield finally decided to approach UWST and purchase a batch of special steel from southern Talos-II.</description>

        <!-- C# Клас і Тікер -->
        <thingClass>AKE.endfield.Building_ICFactoryBase</thingClass>
        <tickerType>Normal</tickerType>

        <!-- Графіка та розміри -->
        <graphicData>
            <texPath>Things/Building/Production/IC_ReactorCrucible</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,5)</drawSize>
        </graphicData>
        <size>(5,5)</size>
        <passability>Impassable</passability>
        <fillPercent>1.0</fillPercent>

        <!-- Можливість переносити та будувати -->
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsProduction</li>
        </thingCategories>
        <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
        <designationCategory>Production</designationCategory>
        <constructEffect>ConstructMetal</constructEffect>

        <!-- Характеристики -->
        <statBases>
            <MaxHitPoints>800</MaxHitPoints>
            <WorkToBuild>180000</WorkToBuild>
            <Mass>600</Mass>
            <Flammability>0.1</Flammability>
        </statBases>

        <!-- Вартість побудови -->
        <costList>
            <IC_Protocolpackage>1</IC_Protocolpackage>
            <IC_Automationpackage>1</IC_Automationpackage>
            <IC_Mechanicalpackage>2</IC_Mechanicalpackage>
            <Steel>450</Steel>
        </costList>

        <researchPrerequisites>
            <li>EF_ImprovedFactories</li>
        </researchPrerequisites>

        <!-- Компоненти (Енергія) -->
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>1200</basePowerConsumption>
            </li>
        </comps>

        <!-- Інтерфейс вкладки рецептів -->
        <inspectorTabs>
            <li>ITab_Bills</li>
        </inspectorTabs>

        <!-- Порожній список рецептів для підтримки патчів -->
        <recipes />

        <!-- Налаштування будівлі -->
        <building>
            <isSittable>false</isSittable>
            <workTableRoomRole>Workshop</workTableRoomRole>
            <buildingTags>
                <li>Production</li>
            </buildingTags>
        </building>
    </ThingDef>
</Defs>