<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>RE_MeleeWeapon_Fortmaker</defName>
    <label>Fortmaker</label>
    <description>A weapon equipped by Endfield operators to significantly boost their combat capabilities.\n\nOne of the weapons made by Fort Forgefane. The sword features traditional architecture that made it extremely durable and sturdy. The thick, heavy blade left countless scars upon the permafrost as the frontlines shifted with the times.\n\n[Weapon Specification]: Heavy kinetic blade. Requires Melee level 11+ to unleash its devastating potential, doubling its base damage and crushing enemy armor via sheer mass.</description>
    <graphicData>
      <texPath>Things/Weapons/Fortmaker</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.2</drawSize>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <weaponTags>
      <li>RE_EndfieldWeapon</li>
    </weaponTags>
    <statBases>
      <MarketValue>1000</MarketValue>
      <WorkToMake>25000</WorkToMake>
      <Mass>2.5</Mass>
    </statBases>
    <equippedAngleOffset>-65</equippedAngleOffset>
    
    <comps>
      <li Class="AKE.endfield.CompProperties_WeaponSkillScaling">
        <scalings>
          <li>
            <skill>Melee</skill>
            <minSkill>11</minSkill> <damageMultiplier>2.0</damageMultiplier>
          </li>
        </scalings>
      </li>
    </comps>

    <tools>
      <li>
        <label>handle</label>
        <capacities><li>Poke</li></capacities>
        <power>8</power>
        <cooldownTime>1.6</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities><li>Stab</li></capacities>
        <power>20</power>
        <cooldownTime>1.8</cooldownTime>
        <armorPenetration>0.50</armorPenetration>
      </li>
      <li>
        <label>edge</label>
        <capacities><li>Cut</li></capacities>
        <power>25</power>
        <cooldownTime>2.0</cooldownTime>
        <armorPenetration>0.40</armorPenetration>
      </li>
    </tools>

    <costList>
      <Steel>100</Steel>
      <IC_FerriumCube>20</IC_FerriumCube>
      <IC_CastDie>5</IC_CastDie>
    </costList>
    
    <recipeMaker>
      <researchPrerequisite>EV_EndfieldMobilization</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      
      <recipeUsers>
        <li>FueledSmithy</li> 
        <li>ElectricSmithy</li>  
      </recipeUsers>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
    </recipeMaker>
  </ThingDef>

</Defs>