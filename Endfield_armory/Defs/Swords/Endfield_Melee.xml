<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp">
    <defName>RE_EndfieldStarterBlade</defName>
    <label>Standard Issue Endfield Blade</label>
    <description>A weapon equipped by Endfield operators to significantly boost their combat capabilities. One of the advanced weaponry manufactured by Endfield for their operators. Minimalist modular architecture resulted in a lightweight weapon with excellent balance and handling. The blade itself is extremely durable.\n\n[Weapon Specification]: Striking enemies with battle skills grants the wielder ATK +12% for 20 seconds (Does not stack).</description>
    <graphicData>
      <texPath>Things/Weapons/EndfieldStarterBlade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.0</drawSize>
    </graphicData>
    <techLevel>Industrial</techLevel>
    
    <smeltable>true</smeltable>
    <burnableByRecipe>false</burnableByRecipe>

    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
    </comps>

    <statBases>
      <WorkToMake>12000</WorkToMake>
      <Mass>1.8</Mass> 
      <MarketValue>150</MarketValue>
    </statBases>
    
    <costList>
      <Steel>40</Steel>
    </costList>
    
    <recipeMaker>
      <researchPrerequisite>Smithing</researchPrerequisite>
      <recipeUsers>
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
      </recipeUsers>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
    </recipeMaker>
    
    <tools>
      <li>
        <label>handle</label>
        <capacities><li>Blunt</li></capacities>
        <power>6</power>
        <cooldownTime>1.5</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities><li>Stab</li></capacities>
        <power>13</power>
        <cooldownTime>1.3</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities><li>Cut</li></capacities>
        <power>15</power>
        <cooldownTime>1.1</cooldownTime>
      </li>
    </tools>
  </ThingDef>
</Defs>