<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <ThingDef ParentName="ResourceBase">
        <defName>IC_Transportpackage</defName>
        <label>Transport package</label>
        <description>A set of transportation and ports for transferring resources over a distance directly to a distribution center. Very useful for drills and is a necessary component for their construction.</description>

        <graphicData>
            <texPath>Things/Resource/IC_Transportpackage</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1, 1)</drawSize>
        </graphicData>

        <soundInteract>Standard_Drop</soundInteract>
        <soundDrop>Standard_Drop</soundDrop>

        <!-- Характеристики -->
        <statBases>
            <MaxHitPoints>100</MaxHitPoints>            <!-- Запас міцності при вибухах -->
            <MarketValue>500</MarketValue>               <!-- Базова вартість -->
            <Mass>5</Mass>                          <!-- Вага -->
            <Flammability>0.5</Flammability>           <!-- Пластик/платівка може горіти -->
            <DeteriorationRate>0.5</DeteriorationRate> <!-- Чутлива електроніка псується під дощем -->
        </statBases>

        <!-- 5. Категорія на Складі -->
        <thingCategories>
            <li>Manufactured</li> <!-- Лежатиме разом з компонентами та мікросхемами -->
        </thingCategories>

        <!-- 6. Зберігання та Логіка -->
        <stackLimit>5</stackLimit>
        <useHitPoints>true</useHitPoints>
        <healthAffectsPrice>true</healthAffectsPrice>
        <burnableByRecipe>false</burnableByRecipe>

        <!-- 7. Торгівля -->
        <tradeTags>
            <li>IndustrialAdvanced</li>
            <li>ExoticMisc</li>
        </tradeTags>
    </ThingDef>

</Defs>