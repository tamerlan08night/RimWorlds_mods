<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <ThingDef ParentName="ResourceBase">
        <defName>IC_Automationpackage</defName>
        <label>Automation package</label>
        <description>A set of materials, chips, electronics, and devices for creating complex automated buildings. One of the important components in the construction of an automated factory.</description>

        <graphicData>
            <texPath>Things/Resource/IC_Automationpackage</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1, 1)</drawSize>
        </graphicData>

        <soundInteract>Standard_Drop</soundInteract>
        <soundDrop>Standard_Drop</soundDrop>

        <!-- Характеристики -->
        <statBases>
            <MaxHitPoints>450</MaxHitPoints>            <!-- Запас міцності при вибухах -->
            <MarketValue>100</MarketValue>               <!-- Базова вартість -->
            <Mass>5</Mass>                          <!-- Вага -->
            <Flammability>0.5</Flammability>           <!-- Пластик/платівка може горіти -->
            <DeteriorationRate>0.5</DeteriorationRate> <!-- Чутлива електроніка псується під дощем -->
        </statBases>

        <!-- 5. Категорія на Складі -->
        <thingCategories>
            <li>Manufactured</li> <!-- Лежатиме разом з компонентами та мікросхемами -->
        </thingCategories>

        <!-- 6. Зберігання та Логіка -->
        <stackLimit>5</stackLimit>
        <useHitPoints>true</useHitPoints>
        <healthAffectsPrice>true</healthAffectsPrice>
        <burnableByRecipe>false</burnableByRecipe>

        <!-- 7. Торгівля -->
        <tradeTags>
            <li>IndustrialAdvanced</li>
            <li>ExoticMisc</li>
        </tradeTags>
    </ThingDef>

</Defs>