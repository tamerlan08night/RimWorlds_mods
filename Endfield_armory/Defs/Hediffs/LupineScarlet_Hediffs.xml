<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>RE_ScarletInstinct</defName>
    <label>scarlet instinct</label>
    <labelNoun>a scarlet instinct charge</labelNoun>
    <description>RAYTHEAN Industries' specialized combat modifications response. Fighting ignited targets sharpens the wielder's senses, accumulating battle focus.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.1, 0.1)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>16</maxSeverity>
    <initialSeverity>1</initialSeverity>
    
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <statOffsets>
          <MoveSpeed>0.05</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RE_LupineApex</defName>
    <label>lupine apex</label>
    <description>CULMINATION! The weapon's subsumed drive reaches maximum capacity, lifting all physical limits. Combat efficiency and striking speed are drastically enhanced.</description>
    <hediffClass>AKE.endfield.Hediff_LupineApex</hediffClass>
    <defaultLabelColor>(0.9, 0.2, 0.2)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.10</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>0.15</offset>
          </li>
        </capMods>
        </li>
    </stages>
  </HediffDef>

</Defs>