<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>RE_TacticalLink</defName>
    <label>Endfield tactical link</label>
    <description>A tactical data synchronization provided by a nearby Edge of Lightness. Increases combat accuracy, pain tolerance, and overall efficiency.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.2, 0.8, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>200</disappearsAfterTicks>
        <showRemainingTime>false</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-10.0</severityPerDay>
      </li>
    </comps>

    <stages>
      <li>
        <minSeverity>0.001</minSeverity>
        <statOffsets>
          <MeleeHitChance>0.15</MeleeHitChance>
          <AimingDelayFactor>-0.10</AimingDelayFactor>
          <PainShockThreshold>0.10</PainShockThreshold>
          <WorkSpeedGlobal>0.05</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>