        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Neutroamine</li>
                    </thingDefs>
                </filter>
                <count>20</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>MedicineHerbal</li>
                    </thingDefs>
                </filter>
                <count>20</count>
            </li>
        </ingredients>

        <fixedIngredientFilter>
            <thingDefs>
                <li>Neutroamine</li>
                <li>MedicineHerbal</li>
            </thingDefs>
