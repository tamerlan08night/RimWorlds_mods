<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- 1. Снаряд -->
    <ThingDef ParentName="BaseBullet">
        <defName>Bullet_IC_EndfieldPlasma</defName>
        <label>plasma bolt</label>
        <graphicData>
            <texPath>Things/Projectile/Charge_Small</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <color>(100, 200, 255)</color>
        </graphicData>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>9</damageAmountBase>
            <armorPenetrationBase>0.16</armorPenetrationBase>
            <speed>100</speed>
        </projectile>
    </ThingDef>

    <!-- 2. Зброя турелі (стовбур) -->
    <ThingDef ParentName="BaseWeaponTurret">
        <defName>Gun_IC_EndfieldPlasmaTurret</defName>
        <label>Endfield plasma turret gun</label>
        <useHitPoints>false</useHitPoints>
        <destroyOnDrop>true</destroyOnDrop>
        <tradeability>None</tradeability>

        <graphicData>
            <texPath>Things/Building/Security/Gun_Tower/Gun</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <AccuracyTouch>0.80</AccuracyTouch>
            <AccuracyShort>0.70</AccuracyShort>
            <AccuracyMedium>0.55</AccuracyMedium>
            <AccuracyLong>0.40</AccuracyLong>
            <RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
            <Mass>40</Mass>
            <Flammability>0</Flammability>
        </statBases>
        <verbs>
            <li Class="VerbProperties">
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Bullet_IC_EndfieldPlasma</defaultProjectile>
                <range>26</range>
                <burstShotCount>10</burstShotCount>
                <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
                <warmupTime>0.5</warmupTime>
                <soundCast>Shot_Autopistol</soundCast>
                <soundCastTail>GunTail_Light</soundCastTail>
                <muzzleFlashScale>9</muzzleFlashScale>
            </li>
        </verbs>
    </ThingDef>

    <!-- 3. Будівля турелі (База) -->
    <ThingDef ParentName="BuildingBase">
        <defName>IC_EndfieldPlasmaTurret</defName>
        <label>Endfield Gun Tower</label>
        <uiIconPath>Things/Building/Security/Gun_Tower/UI_Gun</uiIconPath> <!-- Іконка в меню будівництва -->
        <description>Once the complex firing mechanism was simplified, it was combined with the logic of automation designs to create this integrated weapon platform. Many frontier outposts and villages used prototypes of this system to defend themselves against dangerous wildlife.</description>
        <thingClass>Building_TurretGun</thingClass>

        <drawerType>MapMeshAndRealTime</drawerType>

        <graphicData>
            <texPath>Things/Building/Security/Gun_Tower/Base</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>

        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.75</fillPercent>
        <size>(2,2)</size>

        <statBases>
            <MaxHitPoints>300</MaxHitPoints>
            <WorkToBuild>15000</WorkToBuild>
            <Mass>45</Mass>
            <Flammability>0.2</Flammability>
            <Beauty>0</Beauty>
        </statBases>
        <tickerType>Normal</tickerType>

        <costList>
            <Steel>150</Steel>
            <IC_Origocrust>10</IC_Origocrust>
            <ComponentIndustrial>3</ComponentIndustrial>
        </costList>

        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>200</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable"/>
            <li Class="CompProperties_Breakdownable"/>
        </comps>

        <designationCategory>Security</designationCategory>
        <hasTooltip>true</hasTooltip>
        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>

        <building>
            <ai_combatDangerous>true</ai_combatDangerous>
            <turretGunDef>Gun_IC_EndfieldPlasmaTurret</turretGunDef>
            <turretTopDrawSize>2</turretTopDrawSize>
            <turretBurstCooldownTime>2</turretBurstCooldownTime>
        </building>

        <placeWorkers>
            <li>PlaceWorker_ShowTurretRadius</li>
        </placeWorkers>

        <researchPrerequisites>
            <li>EV_Baseturetts</li>
        </researchPrerequisites>
    </ThingDef>

</Defs>