<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- 1. Важкий снаряд -->
    <ThingDef ParentName="BaseBullet">
        <defName>Bullet_IC_EndfieldHeavyPlasma</defName>
        <label>heavy plasma bolt</label>
        <graphicData>
            <texPath>Things/Projectile/Charge_Small</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <color>(134, 64, 42)</color>
        </graphicData>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>18</damageAmountBase>
            <armorPenetrationBase>0.22</armorPenetrationBase>
            <speed>100</speed>
        </projectile>
    </ThingDef>

    <!-- 2. Зброя турелі (стовбур) -->
    <ThingDef ParentName="BaseWeaponTurret">
        <defName>Gun_IC_EndfieldHeavyPlasmaTurret</defName>
        <label>Endfield heavy plasma turret gun</label>
        <useHitPoints>false</useHitPoints>
        <destroyOnDrop>true</destroyOnDrop>
        <tradeability>None</tradeability>

        <graphicData>
            <texPath>Things/Building/Security/Heavy_Gun_Tower/HeavyGunTower</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <AccuracyTouch>0.70</AccuracyTouch>
            <AccuracyShort>0.60</AccuracyShort>
            <AccuracyMedium>0.45</AccuracyMedium>
            <AccuracyLong>0.30</AccuracyLong>
            <RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
            <Mass>50</Mass>
            <Flammability>0</Flammability>
        </statBases>
        <verbs>
            <li Class="VerbProperties">
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Bullet_IC_EndfieldHeavyPlasma</defaultProjectile>
                <range>30</range>
                <burstShotCount>12</burstShotCount>
                <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
                <warmupTime>0.6</warmupTime>
                <soundCast>Shot_Autopistol</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>12</muzzleFlashScale>
            </li>
        </verbs>
    </ThingDef>

    <!-- 3. Будівля турелі (База) -->
    <ThingDef ParentName="BuildingBase">
        <defName>IC_EndfieldHeavyPlasmaTurret</defName>
        <label>Endfield heavy plasma turret</label>
        <uiIconPath>Things/Building/Security/Heavy_Gun_Tower/UI_Heavy_Gun</uiIconPath> <!-- Іконка в меню будівництва -->
        <description>"An upgraded version of the Gun Tower. People call this the Tomb Digger due to its merciless killing power."\n\nAn improved automated defensive turret designed to defend outposts with high-energy plasma blasts. Thanks to the originium and improved capacitors, it has a greater release of energy from the barrels, improving damage and armor penetration, and an improved sensor slightly improves accuracy and shot calculation.</description>
        <thingClass>Building_TurretGun</thingClass>

        <drawerType>MapMeshAndRealTime</drawerType>

        <graphicData>
            <texPath>Things/Building/Security/Gun_Tower/Base</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>

        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.75</fillPercent>
        <size>(2,2)</size>

        <statBases>
            <MaxHitPoints>450</MaxHitPoints>
            <WorkToBuild>22000</WorkToBuild>
            <Mass>60</Mass>
            <Flammability>0.2</Flammability>
            <Beauty>0</Beauty>
        </statBases>
        <tickerType>Normal</tickerType>

        <costList>
            <Steel>150</Steel>
            <IC_Origocrust>20</IC_Origocrust>
            <IC_FerriumPart>10</IC_FerriumPart>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>

        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>350</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable"/>
            <li Class="CompProperties_Breakdownable"/>
        </comps>

        <designationCategory>Security</designationCategory>
        <hasTooltip>true</hasTooltip>
        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>

        <building>
            <ai_combatDangerous>true</ai_combatDangerous>
            <turretGunDef>Gun_IC_EndfieldHeavyPlasmaTurret</turretGunDef>
            <turretTopDrawSize>2</turretTopDrawSize>
            <turretBurstCooldownTime>2</turretBurstCooldownTime>
        </building>

        <placeWorkers>
            <li>PlaceWorker_ShowTurretRadius</li>
        </placeWorkers>

        <researchPrerequisites>
            <li>EV_ImprovedProtectionSystems</li>
        </researchPrerequisites>
    </ThingDef>

</Defs>