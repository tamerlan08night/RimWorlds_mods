<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <RecipeDef>
    <defName>IC_MakeAmethystPart</defName>
    <label>craft amethyst part</label>
    <description>Assemble an amethyst component using amethyst fibers and steel framework.</description>
    <jobString>Crafting amethyst part.</jobString>
    <workAmount>1200</workAmount> <!-- 20 seconds (20 * 60 ticks) -->
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>EF_fitting</soundWorking>

    <researchPrerequisite>EM_MaterialsProcessing</researchPrerequisite>
    
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>IC_AmethystFiber</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    
    <fixedIngredientFilter>
      <thingDefs>
        <li>IC_AmethystFiber</li>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <recipeUsers>
      <li>IC_AIC_FittingUnit</li>
    </recipeUsers>
    
    <products>
      <IC_AmethystPart>1</IC_AmethystPart>
    </products>
  </RecipeDef>
</Defs>