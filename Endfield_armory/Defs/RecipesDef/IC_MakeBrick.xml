<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- Піщанник -->
    <RecipeDef>
        <defName>RF_FireBlocksSandstone</defName>
        <label>Fire blocks sandstone.</label>
        <description>Fire bricks from Sandstone.</description>
        <jobString>Fire the bricks.</jobString>
        <workAmount>1800</workAmount>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <effectWorking>Cook</effectWorking>
        <soundWorking>EF_refinery</soundWorking>

        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>ChunkSandstone</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>

        <fixedIngredientFilter>
            <thingDefs>
                <li>ChunkSandstone</li>
            </thingDefs>
        </fixedIngredientFilter>
        <recipeUsers>
            <li>AIC_RefiningUnit</li>
        </recipeUsers>

        <products>
            <BlocksSandstone>20</BlocksSandstone>
        </products>

    </RecipeDef>

