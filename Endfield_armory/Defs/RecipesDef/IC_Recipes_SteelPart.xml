<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <RecipeDef>
    <defName>IC_MakeSteelPartFromVanillaSteel</defName>
    <label>make steel part (vanilla steel)</label>
    <description>Craft a steel part using standard steel.</description>
    <jobString>Making steel part.</jobString>
    <workAmount>1200</workAmount> <!-- 20 seconds (20 * 60 ticks) -->
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>EF_fitting</soundWorking>

    <researchPrerequisite>EM_AdvancedMaterials</researchPrerequisite>
    
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    
    <recipeUsers>
      <li>IC_AIC_FittingUnit</li>
    </recipeUsers>
    
    <products>
      <IC_SteelPart>1</IC_SteelPart>
    </products>
  </RecipeDef>

  <!-- Крафт із сталі Endfield -->
  <RecipeDef>
    <defName>IC_MakeSteelPartFromEndfieldSteel</defName>
    <label>make steel part (endfield steel)</label>
    <description>Craft a steel part using Endfield steel.</description>
    <jobString>Making steel part.</jobString>
    <workAmount>1200</workAmount> <!-- 20 seconds (20 * 60 ticks) -->
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cremate</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>

    <researchPrerequisite>EM_AdvancedMaterials</researchPrerequisite>
    
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>IC_EndfieldSteel</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    
    <fixedIngredientFilter>
      <thingDefs>
        <li>IC_EndfieldSteel</li>
      </thingDefs>
    </fixedIngredientFilter>
    
    <recipeUsers>
      <li>IC_AIC_FittingUnit</li>
    </recipeUsers>
    
    <products>
      <IC_SteelPart>1</IC_SteelPart>
    </products>
  </RecipeDef>
</Defs>