      <li>
        <filter>
          <thingDefs>
            <li>OE_RawFerium</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    
    <fixedIngredientFilter>
      <thingDefs>
        <li>OE_RawFerium</li>
      </thingDefs>
    </fixedIngredientFilter>
    <recipeUsers>
      <li>AIC_RefiningUnit</li>
    </recipeUsers>
    
    <products>
      <IC_FerriumCube>1</IC_FerriumCube>
    </products>
    
  </RecipeDef>
