<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <!-- Сталь -->
    <RecipeDef>
        <defName>GU_SteelForming</defName>
        <label>Shape steel.</label>
        <description>Melt steel from enriched stone conglomerate.</description>
        <jobString>Form steel.</jobString>
        <workAmount>1000</workAmount>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <effectWorking>Cook</effectWorking>
        <soundWorking>EF_refinery</soundWorking>

        <researchPrerequisite>EM_metalForming</researchPrerequisite>

        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>IC_EnrichedStoneConglomerate</li>
                    </thingDefs>
                </filter>
                <count>10</count>
            </li>
        </ingredients>

        <fixedIngredientFilter>
            <thingDefs>
                <li>IC_EnrichedStoneConglomerate</li>
            </thingDefs>
        </fixedIngredientFilter>
        <recipeUsers>
            <li>AIC_RefiningUnit</li>
        </recipeUsers>

        <products>
            <Steel>5</Steel>
        </products>

    </RecipeDef>

