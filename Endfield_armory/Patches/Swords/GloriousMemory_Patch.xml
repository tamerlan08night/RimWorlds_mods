<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="RE_GloriousMemory"]/tools</xpath>
          <value>
            <tools>
              <li Class="CombatExtended.ToolCE">
                <label>point</label>
                <capacities><li>Stab</li></capacities>
                <power>14</power> <cooldownTime>1.15</cooldownTime>
                <armorPenetrationSharp>14</armorPenetrationSharp> <armorPenetrationBlunt>2.5</armorPenetrationBlunt>
                <linkedBodyPartsGroup>Point</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>edge</label>
                <capacities><li>Cut</li></capacities>
                <power>17</power> <cooldownTime>1.15</cooldownTime>
                <armorPenetrationSharp>6</armorPenetrationSharp> <armorPenetrationBlunt>3.0</armorPenetrationBlunt>
                <linkedBodyPartsGroup>Edge</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RE_GloriousMemory"]/statBases</xpath>
          <value>
            <Bulk>4.0</Bulk>
            <MeleeCritChance>0.20</MeleeCritChance>
            <MeleeParryChance>0.65</MeleeParryChance>
          </value>
        </li>

      </operations>
    </match>
  </Operation>
</Patch>