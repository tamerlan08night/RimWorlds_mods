<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods><li>Combat Extended</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
        
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="RE_Aspirant"]/tools</xpath>
          <value>
            <tools>
              <li Class="CombatExtended.ToolCE">
                <label>handle</label>
                <capacities><li>Blunt</li></capacities>
                <power>5</power>
                <cooldownTime>1.0</cooldownTime>
                <armorPenetrationBlunt>0.5</armorPenetrationBlunt>
                <linkedBodyPartsGroup>Handle</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>point</label>
                <capacities><li>Stab</li></capacities>
                <power>11</power> <cooldownTime>1.3</cooldownTime>
                <armorPenetrationSharp>12</armorPenetrationSharp> <armorPenetrationBlunt>2.0</armorPenetrationBlunt>
                <linkedBodyPartsGroup>Point</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>edge</label>
                <capacities><li>Cut</li></capacities>
                <power>13</power> <cooldownTime>1.0</cooldownTime> <armorPenetrationSharp>8</armorPenetrationSharp>
                <armorPenetrationBlunt>1.5</armorPenetrationBlunt>
                <linkedBodyPartsGroup>Edge</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RE_Aspirant"]/statBases</xpath>
          <value>
            <Bulk>4.0</Bulk>
            <MeleeCritChance>0.15</MeleeCritChance>
            <MeleeParryChance>0.45</MeleeParryChance>
          </value>
        </li>

      </operations>
    </match>
  </Operation>
</Patch>