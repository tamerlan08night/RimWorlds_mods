<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="RE_GrandVision"]/tools</xpath>
          <value>
            <tools>
              <li Class="CombatExtended.ToolCE">
                <label>point</label>
                <capacities><li>Stab</li></capacities>
                <power>13</power> <cooldownTime>1.25</cooldownTime>
                <armorPenetrationSharp>24</armorPenetrationSharp> <armorPenetrationBlunt>4.0</armorPenetrationBlunt>
                <linkedBodyPartsGroup>Point</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>edge</label>
                <capacities><li>Cut</li></capacities>
                <power>15</power> <cooldownTime>1.25</cooldownTime>
                <armorPenetrationSharp>18</armorPenetrationSharp> <armorPenetrationBlunt>8.0</armorPenetrationBlunt>
                <linkedBodyPartsGroup>Edge</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RE_GrandVision"]/statBases</xpath>
          <value>
            <Bulk>5.5</Bulk>
            <MeleeCritChance>0.25</MeleeCritChance>
            <MeleeParryChance>0.55</MeleeParryChance> </value>
        </li>

      </operations>
    </match>
  </Operation>
</Patch>