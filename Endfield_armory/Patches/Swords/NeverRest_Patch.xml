<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="RE_NeverRest"]/tools</xpath>
          <value>
            <tools>
              <li Class="CombatExtended.ToolCE">
                <label>point</label>
                <capacities><li>Stab</li></capacities>
                <power>22</power> <cooldownTime>1.35</cooldownTime>
                <armorPenetrationSharp>24</armorPenetrationSharp> <armorPenetrationBlunt>5.5</armorPenetrationBlunt>
                <linkedBodyPartsGroup>Point</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>edge</label>
                <capacities><li>Cut</li></capacities>
                <power>26</power> <cooldownTime>1.35</cooldownTime>
                <armorPenetrationSharp>18</armorPenetrationSharp> <armorPenetrationBlunt>8.5</armorPenetrationBlunt> <linkedBodyPartsGroup>Edge</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RE_NeverRest"]/statBases</xpath>
          <value>
            <Bulk>5.0</Bulk>
            <MeleeCritChance>0.30</MeleeCritChance>
            <MeleeParryChance>0.50</MeleeParryChance>
          </value>
        </li>

      </operations>
    </match>
  </Operation>
</Patch>