<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Combat Extended</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>

                <!-- ==================== 1. SEMI-HE GRENADE TOWER ==================== -->

                <!-- Снаряд Semi-HE (60 мм пробиття, без осколків) -->
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Bullet_IC_SemiHEGrenade"]</xpath>
                    <value>
                        <thingClass>CombatExtended.BulletCE</thingClass>
                    </value>
                </li>

                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="Bullet_IC_SemiHEGrenade"]/projectile</xpath>
                    <value>
                        <projectile Class="CombatExtended.ProjectilePropertiesCE">
                            <damageDef>Bomb</damageDef>
                            <damageAmountBase>55</damageAmountBase>
                            <armorPenetrationSharp>60</armorPenetrationSharp>
                            <armorPenetrationBlunt>25</armorPenetrationBlunt>
                            <explosionRadius>1.9</explosionRadius>
                            <speed>70</speed>
                            <soundExplode>Explosion_Bomb</soundExplode>
                        </projectile>
                    </value>
                </li>

                <!-- Зброя Semi-HE -->
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Gun_IC_EndfieldSemiHETurret"]/statBases</xpath>
                    <value>
                        <SightsEfficiency>1.0</SightsEfficiency>
                        <ShotSpread>0.10</ShotSpread>
                        <SwayFactor>1.2</SwayFactor>
                    </value>
                </li>

                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="Gun_IC_EndfieldSemiHETurret"]/verbs</xpath>
                    <value>
                        <verbs>
                            <li Class="CombatExtended.VerbPropertiesCE">
                                <verbClass>CombatExtended.Verb_ShootCE</verbClass>
                                <hasStandardCommand>true</hasStandardCommand>
                                <defaultProjectile>Bullet_IC_SemiHEGrenade</defaultProjectile>
                                <warmupTime>1.0</warmupTime>
                                <range>30.0</range>
                                <burstShotCount>1</burstShotCount>
                                <soundCast>Shot_IncendiaryLauncher</soundCast>
                                <soundCastTail>GunTail_Heavy</soundCastTail>
                                <muzzleFlashScale>12</muzzleFlashScale>
                                <targetParams>
                                    <canTargetLocations>true</canTargetLocations>
                                </targetParams>
                            </li>
                        </verbs>
                    </value>
                </li>

                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Gun_IC_EndfieldSemiHETurret"]</xpath>
                    <value>
                        <comps>
                            <li Class="CombatExtended.CompProperties_FireModes">
                                <aiAimMode>AimedShot</aiAimMode>
                                <noSingleShot>false</noSingleShot>
                            </li>
                        </comps>
                    </value>
                </li>

                <!-- Будівля Semi-HE -->
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="IC_EndfieldSemiHETurret"]/thingClass</xpath>
                    <value>
                        <thingClass>CombatExtended.Building_TurretGunCE</thingClass>
                    </value>
                </li>

                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="IC_EndfieldSemiHETurret"]/statBases</xpath>
                    <value>
                        <AimingAccuracy>0.6</AimingAccuracy>
                        <ShootingAccuracyTurret>1.0</ShootingAccuracyTurret>
                    </value>
                </li>


                <!-- ==================== 2. PURE HE GRENADE TOWER ==================== -->

                <!-- 1. Створення кастомних осколків (з пробиттям 20 мм і 15 мм та ванільною текстурою) -->
                <li Class="PatchOperationAdd">
                    <xpath>Defs</xpath>
                    <value>
                        <ThingDef ParentName="BaseBullet">
                            <defName>Bullet_IC_PureHE_Fragment_Large</defName>
                            <label>large fragment</label>
                            <thingClass>CombatExtended.BulletCE</thingClass>
                            <graphicData>
                                <texPath>Things/Projectile/Bullet_Small</texPath>
                                <graphicClass>Graphic_Single</graphicClass>
                            </graphicData>
                            <projectile Class="CombatExtended.ProjectilePropertiesCE">
                                <damageDef>Fragment</damageDef>
                                <damageAmountBase>24</damageAmountBase>
                                <armorPenetrationSharp>20</armorPenetrationSharp>
                                <armorPenetrationBlunt>5</armorPenetrationBlunt>
                                <speed>70</speed>
                                <gravityFactor>15</gravityFactor>
                            </projectile>
                        </ThingDef>

                        <ThingDef ParentName="BaseBullet">
                            <defName>Bullet_IC_PureHE_Fragment_Small</defName>
                            <label>small fragment</label>
                            <thingClass>CombatExtended.BulletCE</thingClass>
                            <graphicData>
                                <texPath>Things/Projectile/Bullet_Small</texPath>
                                <graphicClass>Graphic_Single</graphicClass>
                            </graphicData>
                            <projectile Class="CombatExtended.ProjectilePropertiesCE">
                                <damageDef>Fragment</damageDef>
                                <damageAmountBase>12</damageAmountBase>
                                <armorPenetrationSharp>10</armorPenetrationSharp>
                                <armorPenetrationBlunt>2</armorPenetrationBlunt>
                                <speed>50</speed>
                                <gravityFactor>20</gravityFactor>
                            </projectile>
                        </ThingDef>
                    </value>
                </li>

                <!-- 2. Снаряд Pure HE -->
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Bullet_IC_PureHEGrenade"]</xpath>
                    <value>
                        <thingClass>CombatExtended.BulletCE</thingClass>
                    </value>
                </li>

                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="Bullet_IC_PureHEGrenade"]/projectile</xpath>
                    <value>
                        <projectile Class="CombatExtended.ProjectilePropertiesCE">
                            <damageDef>Bomb</damageDef>
                            <damageAmountBase>80</damageAmountBase>
                            <armorPenetrationSharp>35</armorPenetrationSharp>
                            <armorPenetrationBlunt>15</armorPenetrationBlunt>
                            <explosionRadius>3.2</explosionRadius>
                            <speed>50</speed>
                            <soundExplode>Explosion_Rocket</soundExplode>
                        </projectile>
                    </value>
                </li>

                <!-- 3. Підключення кастомних осколків до снаряда -->
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Bullet_IC_PureHEGrenade"]</xpath>
                    <value>
                        <comps>
                            <li Class="CombatExtended.CompProperties_Fragments">
                                <fragments>
                                    <Bullet_IC_PureHE_Fragment_Large>10</Bullet_IC_PureHE_Fragment_Large>
                                    <Bullet_IC_PureHE_Fragment_Small>20</Bullet_IC_PureHE_Fragment_Small>
                                </fragments>
                            </li>
                        </comps>
                    </value>
                </li>

                <!-- 4. Зброя Pure HE -->
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Gun_IC_EndfieldPureHETurret"]/statBases</xpath>
                    <value>
                        <SightsEfficiency>1.0</SightsEfficiency>
                        <ShotSpread>0.14</ShotSpread>
                        <SwayFactor>1.3</SwayFactor>
                    </value>
                </li>

                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="Gun_IC_EndfieldPureHETurret"]/verbs</xpath>
                    <value>
                        <verbs>
                            <li Class="CombatExtended.VerbPropertiesCE">
                                <verbClass>CombatExtended.Verb_ShootCE</verbClass>
                                <hasStandardCommand>true</hasStandardCommand>
                                <defaultProjectile>Bullet_IC_PureHEGrenade</defaultProjectile>
                                <warmupTime>1.0</warmupTime>
                                <minRange>7</minRange>
                                <range>30</range>
                                <burstShotCount>1</burstShotCount>
                                <soundCast>Shot_IncendiaryLauncher</soundCast>
                                <soundCastTail>GunTail_Heavy</soundCastTail>
                                <muzzleFlashScale>15</muzzleFlashScale>
                                <targetParams>
                                    <canTargetLocations>true</canTargetLocations>
                                </targetParams>
                            </li>
                        </verbs>
                    </value>
                </li>

                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Gun_IC_EndfieldPureHETurret"]</xpath>
                    <value>
                        <comps>
                            <li Class="CombatExtended.CompProperties_FireModes">
                                <aiAimMode>AimedShot</aiAimMode>
                                <noSingleShot>false</noSingleShot>
                            </li>
                        </comps>
                    </value>
                </li>

                <!-- 5. Будівля Pure HE -->
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="IC_EndfieldPureHETurret"]/thingClass</xpath>
                    <value>
                        <thingClass>CombatExtended.Building_TurretGunCE</thingClass>
                    </value>
                </li>

                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="IC_EndfieldPureHETurret"]/statBases</xpath>
                    <value>
                        <AimingAccuracy>0.5</AimingAccuracy>
                        <ShootingAccuracyTurret>0.9</ShootingAccuracyTurret>
                    </value>
                </li>

            </operations>
        </match>
    </Operation>

</Patch>